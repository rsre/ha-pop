[Unit]
Description=Home Assistant panel wake endpoint
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HA_PANEL_REMOTE_TOKEN_FILE=%h/.config/ha-panel/remote-token
ExecStart=/usr/bin/python3 %h/.local/bin/ha-panel-remote.py
ExecStopPost=/usr/bin/systemctl --user start ha-panel-idle.service
Restart=always
RestartSec=5
UMask=0077
