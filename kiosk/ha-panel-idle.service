[Unit]
Description=Sleep the touchscreen until input is detected
PartOf=graphical-session.target

[Service]
Type=simple
Environment=HA_PANEL_IDLE_SECONDS=300
EnvironmentFile=-%h/.config/ha-panel/idle.conf
ExecStart=/usr/bin/swayidle -C /dev/null -w timeout ${HA_PANEL_IDLE_SECONDS} "/usr/bin/systemctl --user start ha-panel-wake-guard.service" resume "/usr/bin/systemctl --user kill --kill-whom=main --signal=SIGUSR1 ha-panel-wake-guard.service || /usr/bin/wlopm --on DSI-1"
ExecStopPost=/usr/bin/systemctl --user stop ha-panel-wake-guard.service
ExecStopPost=/usr/bin/wlopm --on DSI-1
Restart=on-failure
RestartSec=5
